[Unit]
Description=Ubuntu Control privileged power safety self-check (read-only)
Documentation=man:systemctl(1)

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/ubuntu-control-power/power_execute.py --check
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=full
