# Example only: replace user and paths before using.
[Unit]
Description=Ubuntu Control private Raspberry Pi hub (localhost only)
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
User=YOUR_PI_USER
Group=YOUR_PI_USER
WorkingDirectory=/home/YOUR_PI_USER/ubuntu-control
ExecStart=/home/YOUR_PI_USER/ubuntu-control/.venv/bin/python /home/YOUR_PI_USER/ubuntu-control/web/server.py
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
[Install]
WantedBy=multi-user.target
